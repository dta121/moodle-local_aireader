{{!
    @template local_aireader/player_slim

    Slim single-row player used by the slimbar / slimpill / dockpill designs.
    One 56px row when idle; the speed pill, transcript pill, and the bottom
    progress strip appear once the learner starts playback (is-started class).
    Skip, restart, download, regenerate, the manager toggle, and the AI
    disclosure live in the ⋯ overflow menu.

    Exposes the exact same data-region / data-action hooks and control class
    names as local_aireader/player, so the player AMD module drives both
    templates unchanged.

    Context variables: same as local_aireader/player, plus:
      * stringMore - aria-label for the overflow menu button

    Example context (json):
    {
      "disclosure": "Audio narration is AI-generated.",
      "managerlabelon": "Turn off for this page",
      "stringListen": "Listen to this content",
      "stringLoading": "Loading…",
      "stringPlay": "Play",
      "stringSkipBack": "Skip back 15 seconds",
      "stringSkipForward": "Skip forward 15 seconds",
      "stringLanguage": "Language",
      "stringVoice": "Voice",
      "stringProgress": "Playback position",
      "stringSpeed": "Speed",
      "stringPlaybackSpeed": "Playback speed",
      "stringRestart": "Restart from beginning",
      "stringDownload": "Download audio",
      "stringRegenerate": "Regenerate audio",
      "stringShowTranscript": "Show transcript",
      "stringTranscript": "Transcript",
      "stringPreparingTranscript": "Preparing transcript…",
      "stringMore": "More options"
    }
}}
<div class="local-aireader local-aireader-player local-aireader-slim" data-state="loading" role="region" aria-label="{{stringListen}}" tabindex="-1">
  <div class="local-aireader-slim-row">
    <button type="button"
            class="local-aireader-playpause"
            data-action="playpause"
            disabled
            aria-label="{{stringPlay}}">
      <svg class="local-aireader-icon-play" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
        <path d="M8 5v14l11-7z"/>
      </svg>
      <svg class="local-aireader-icon-pause d-none" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
        <path d="M6 4h4v16H6zM14 4h4v16h-4z"/>
      </svg>
    </button>
    <div class="local-aireader-slim-body">
      <span class="local-aireader-slim-title">{{stringListen}}</span>
      <span class="local-aireader-slim-sub">
        <span class="local-aireader-meta" data-region="status" aria-live="polite">{{stringLoading}}</span>
        <span class="local-aireader-time" data-region="time" aria-hidden="true">--:--</span>
      </span>
    </div>
    <span class="local-aireader-spacer"></span>
    <div class="local-aireader-speed local-aireader-slim-afterstart" data-region="speed">
      <select class="local-aireader-speed-select" data-action="set-speed" aria-label="{{stringPlaybackSpeed}}">
        <option value="0.75">0.75&times;</option>
        <option value="1" selected>1&times;</option>
        <option value="1.25">1.25&times;</option>
        <option value="1.5">1.5&times;</option>
        <option value="1.75">1.75&times;</option>
        <option value="2">2&times;</option>
      </select>
    </div>
    <button type="button"
            class="local-aireader-transcript-toggle local-aireader-slim-afterstart d-none"
            data-action="toggle-transcript"
            aria-expanded="false"
            aria-label="{{stringShowTranscript}}">
      <span data-region="transcript-toggle-label">{{stringTranscript}}</span>
    </button>
    <div class="local-aireader-langpicker d-none" data-region="langpicker">
      <select class="local-aireader-langselect" data-action="set-lang" aria-label="{{stringLanguage}}"></select>
    </div>
    <div class="local-aireader-voicepicker d-none" data-region="voicepicker">
      <select class="local-aireader-voiceselect" data-action="set-voice" aria-label="{{stringVoice}}"></select>
    </div>
    <div class="local-aireader-slim-menuwrap">
      <button type="button"
              class="local-aireader-slim-menubtn"
              data-action="menu"
              aria-haspopup="true"
              aria-expanded="false"
              aria-label="{{stringMore}}">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
          <circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/>
        </svg>
      </button>
      <div class="local-aireader-slim-menu d-none" data-region="menu" role="menu">
        <button type="button"
                class="local-aireader-slim-menuitem local-aireader-skipback"
                data-action="skipback"
                disabled
                role="menuitem">{{stringSkipBack}}</button>
        <button type="button"
                class="local-aireader-slim-menuitem local-aireader-skipfwd"
                data-action="skipfwd"
                disabled
                role="menuitem">{{stringSkipForward}}</button>
        <button type="button"
                class="local-aireader-slim-menuitem local-aireader-restart"
                data-action="restart"
                disabled
                role="menuitem">{{stringRestart}}</button>
        <a class="local-aireader-slim-menuitem local-aireader-download d-none"
           href="#"
           data-region="download"
           download
           role="menuitem">{{stringDownload}} <span class="local-aireader-download-size" data-region="download-size"></span></a>
        <button type="button"
                class="local-aireader-slim-menuitem local-aireader-regen d-none"
                data-action="regen"
                role="menuitem">{{stringRegenerate}}</button>
        <div class="local-aireader-manager d-none" data-region="manager">
          <button type="button"
                  class="local-aireader-slim-menuitem local-aireader-managerbtn"
                  data-action="toggle-enabled"
                  aria-pressed="true">
            <span data-region="manager-label">{{managerlabelon}}</span>
          </button>
        </div>
        <div class="local-aireader-slim-menudisclosure local-aireader-disclosure">{{disclosure}}</div>
      </div>
    </div>
  </div>

  <div class="local-aireader-progress-row local-aireader-slim-progressrow">
    <div class="local-aireader-progress"
         data-region="progress"
         role="slider"
         aria-label="{{stringProgress}}"
         aria-valuemin="0"
         aria-valuemax="100"
         aria-valuenow="0"
         tabindex="0">
      <div class="local-aireader-progress-fill" data-region="progress-fill"></div>
      <div class="local-aireader-progress-thumb" data-region="progress-thumb"></div>
    </div>
  </div>

  <div class="local-aireader-transcript-pane d-none" data-region="transcript-pane" aria-live="off">
    <p class="local-aireader-transcript-empty" data-region="transcript-empty">{{stringPreparingTranscript}}</p>
    <ol class="local-aireader-transcript-list" data-region="transcript-list"></ol>
  </div>

  <audio data-region="audio" preload="none" class="d-none"></audio>
</div>
